{% if section.settings.btn_text != blank %}
  <a href="{{ section.settings.btn_link }}"
     class="sr-banner-btn btn-{{ section.settings.btn_style }}"
     style="
       --btn-bg: {{ section.settings.btn_bg }};
       --btn-text: {{ section.settings.btn_text_color }};
       --btn-border: {{ section.settings.btn_border }};
       --btn-hover-bg: {{ section.settings.btn_hover_bg }};
       --btn-hover-text: {{ section.settings.btn_hover_text }};
       --btn-hover-border: {{ section.settings.btn_hover_border }};
     "
  >

    {% if section.settings.btn_icon_position == 'left' %}
      <span class="sr-banner-btn-icon">{{ section.settings.btn_icon }}</span>
    {% endif %}

    <span>{{ section.settings.btn_text }}</span>

    {% if section.settings.btn_icon_position == 'right' %}
      <span class="sr-banner-btn-icon">{{ section.settings.btn_icon }}</span>
    {% endif %}

  </a>
{% endif %}