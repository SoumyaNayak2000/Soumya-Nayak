{{ 'sr-banner.css' | asset_url | stylesheet_tag }}

<section
  class="sr-banner width-{{ section.settings.section_width }} content-{{ section.settings.content_position }}"
  style="
    height: {{ section.settings.section_height }}px;
  "
>
  <div
    class="sr-banner-overlay"
    style="
      background: {{ section.settings.overlay_color }};
      opacity: {{ section.settings.overlay_opacity }};
    "
  ></div>

  <div class="sr-banner-inner content-{{ section.settings.content_position }}">
    {% render 'sr-banner-content', section: section %}
  </div>
</section>

<style>
  /* DESKTOP BACKGROUND */
  #shopify-section-{{ section.id }} .sr-banner {
    {% if section.settings.bg_image != blank %}
    background-image: url({{ section.settings.bg_image | image_url: width: 2000 }});
  {% else %}
    background-image: url({{ 'sr-desktop-banner.png' | asset_url }});
  {% endif %}
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* MOBILE BACKGROUND */
@media (max-width: 768px) {
  #shopify-section-{{ section.id }} .sr-banner {
     {% if section.settings.mobile_bg != blank %}
      background-image: url({{ section.settings.mobile_bg | image_url: width: 1000 }}) !important;

    {% elsif section.settings.bg_image != blank %}
      background-image: url({{ section.settings.bg_image | image_url: width: 1000 }}) !important;

    {% else %}
      background-image: url({{ 'sr-mobile-banner.png' | asset_url }}) !important;

    {% endif %}
  }
}
</style>

<script>
  function setMobileBanner() {
    if (window.innerWidth <= 768) {
      document.querySelectorAll('.sr-banner').forEach(el => {
  const mobileBg = el.getAttribute('data-mobile-bg');
  if (mobileBg && window.innerWidth <= 768) {
    el.style.backgroundImage = `url(${mobileBg})`;
  }
});
    }
  }

  setMobileBanner();
  window.addEventListener('resize', setMobileBanner);
</script>

{% schema %}
{
  "name": "SR Banner",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "header",
      "content": "Heading Style"
    },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Description Style"
    },
    { "type": "textarea", "id": "text", "label": "Description" },
    {
      "type": "range",
      "id": "desc_size",
      "label": "Description Size",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 16
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Color",
      "default": "#555555"
    },

    { "type": "header", "content": "Background" },

    { "type": "image_picker", "id": "bg_image", "label": "Desktop Background" },
    { "type": "image_picker", "id": "mobile_bg", "label": "Mobile Background" },

    { "type": "color", "id": "overlay_color", "label": "Overlay Color", "default": "#000000" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3
    },

    { "type": "header", "content": "Layout" },

    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "full", "label": "Full Width" },
        { "value": "boxed", "label": "Boxed" }
      ]
    },

    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height",
      "min": 300,
      "max": 800,
      "step": 20,
      "default": 500
    },

    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position",
      "options": [
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-center", "label": "Top Center" },
        { "value": "top-right", "label": "Top Right" },

        { "value": "center-left", "label": "Center Left" },
        { "value": "center-center", "label": "Center Center" },
        { "value": "center-right", "label": "Center Right" },

        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-center", "label": "Bottom Center" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ]
    },

    { "type": "header", "content": "Spacing" },

    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 0, "max": 100, "step": 4, "default": 20 },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 20
    },
    { "type": "range", "id": "padding_left", "label": "Padding Left", "min": 0, "max": 100, "step": 4, "default": 20 },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 20
    },

    { "type": "header", "content": "Button" },

    { "type": "text", "id": "btn_text", "label": "Button Text" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },

    { "type": "color", "id": "btn_bg", "label": "Button BG" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color" },

    { "type": "color", "id": "btn_hover_bg", "label": "Hover BG" },
    { "type": "color", "id": "btn_hover_text", "label": "Hover Text" },

    {
      "type": "color",
      "id": "btn_border",
      "label": "Border Color",
      "default": "#000000"
    },

    {
      "type": "color",
      "id": "btn_hover_border",
      "label": "Hover Border",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "Animation Style",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "scale", "label": "Scale" },
        { "value": "invert", "label": "Invert" }
      ],
      "default": "slide"
    },
    {
      "type": "select",
      "id": "btn_icon",
      "label": "Icon",
      "options": [
        { "value": "→", "label": "Arrow" },
        { "value": "➜", "label": "Arrow Bold" },
        { "value": "★", "label": "Star" }
      ],
      "default": "→"
    },
    {
      "type": "select",
      "id": "btn_icon_position",
      "label": "Icon Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    }
  ]
}
{% endschema %}
