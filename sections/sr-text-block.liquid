{{ 'sr-text-block.css' | asset_url | stylesheet_tag }}

<section 
  class="sr-text-block width-{{ section.settings.section_width }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  "
>

  <div 
    class="sr-text-inner"
    style="max-width: {{ section.settings.boxed_width }}px;"
  >

    {% if section.settings.heading != blank %}
      <h2 
        class="sr-heading"
        style="
          font-size: {{ section.settings.heading_size }}px;
          color: {{ section.settings.heading_color }};
          font-weight: {{ section.settings.heading_weight }};
          text-align: {{ section.settings.text_align }};
        "
      >
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p 
        class="sr-description"
        style="
          font-size: {{ section.settings.desc_size }}px;
          color: {{ section.settings.desc_color }};
          text-align: {{ section.settings.text_align }};
        "
      >
        {{ section.settings.description }}
      </p>
    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "SR Text Block",
  "settings": [

    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Heading Here"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Add your description here."
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "full", "label": "Full Width" },
        { "value": "boxed", "label": "Boxed" }
      ],
      "default": "boxed"
    },
    {
      "type": "range",
      "id": "boxed_width",
      "label": "Boxed Width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "default": 1200
    },

    {
      "type": "header",
      "content": "Heading Style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Font Size",
      "min": 16,
      "max": 80,
      "step": 2,
      "default": 36
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },

    {
      "type": "header",
      "content": "Description Style"
    },
    {
      "type": "range",
      "id": "desc_size",
      "label": "Font Size",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 16
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Color",
      "default": "#555555"
    },

    {
      "type": "header",
      "content": "Alignment & Spacing"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 60
    },

    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }

  ],
  "presets": [
    {
      "name": "SR Text Block"
    }
  ]
}
{% endschema %}